"use client";

import { useState, useEffect, useCallback, useRef } from "react";
import {
  ClassData,
  Student,
  Evaluation,
  Grade,
  EvaluationType,
} from "@/types";
import AppHeader from "@/components/AppHeader";
import ClassSidebar from "@/components/ClassSidebar";
import GradeTable from "@/components/GradeTable";
import ReportCard from "@/components/ReportCard";
import SavesModal from "@/components/SavesModal";

interface ClassFullData {
  class: ClassData;
  students: Student[];
  evaluations: Evaluation[];
  grades: Grade[];
}

const AUTOSAVE_INTERVAL = 30000; // 30 seconds

export default function Home() {
  const [classes, setClasses] = useState<ClassData[]>([]);
  const [currentClassId, setCurrentClassId] = useState<string | null>(null);
  const [classData, setClassData] = useState<ClassFullData | null>(null);
  const [loading, setLoading] = useState(false);
  const [lastSaved, setLastSaved] = useState<Date | null>(null);
  const [isSaving, setIsSaving] = useState(false);
  const [showReport, setShowReport] = useState(false);
  const [showSaves, setShowSaves] = useState(false);
  const [pendingGrades, setPendingGrades] = useState<Map<string, Partial<Grade>>>(new Map());
  const [pendingStudents, setPendingStudents] = useState<Map<string, Partial<Student>>>(new Map());
  const autoSaveTimer = useRef<ReturnType<typeof setInterval> | null>(null);
  const gradeFlushTimer = useRef<ReturnType<typeof setTimeout> | null>(null);
  const studentFlushTimer = useRef<ReturnType<typeof setTimeout> | null>(null);

  // Load classes
  const loadClasses = async () => {
    try {
      const res = await fetch("/api/classes");
      const data = await res.json();
      setClasses(data);
    } catch (e) {
      console.error(e);
    }
  };

  useEffect(() => {
    loadClasses();
  }, []);

  // Load class data
  const loadClassData = async (classId: string) => {
    setLoading(true);
    try {
      const res = await fetch(`/api/classes/${classId}`);
      const data = await res.json();
      setClassData(data);
    } catch (e) {
      console.error(e);
    } finally {
      setLoading(false);
    }
  };

  const handleSelectClass = (classId: string) => {
    setCurrentClassId(classId);
    loadClassData(classId);
  };

  // Create class
  const handleCreateClass = async (data: Partial<ClassData>) => {
    try {
      const res = await fetch("/api/classes", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(data),
      });
      const newClass = await res.json();
      await loadClasses();
      handleSelectClass(newClass.id);
    } catch (e) {
      console.error(e);
    }
  };

  // Delete class
  const handleDeleteClass = async (classId: string) => {
    if (!confirm("Supprimer cette classe ? Cette action est irréversible.")) return;
    try {
      await fetch(`/api/classes/${classId}`, { method: "DELETE" });
      await loadClasses();
      if (currentClassId === classId) {
        setCurrentClassId(null);
        setClassData(null);
      }
    } catch (e) {
      console.error(e);
    }
  };

  // Manual save
  const handleManualSave = async () => {
    if (!currentClassId) return;
    setIsSaving(true);
    try {
      // Flush pending changes first
      await flushPendingChanges();
      await fetch("/api/saves", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          classId: currentClassId,
          label: `Sauvegarde du ${new Date().toLocaleString("fr-FR")}`,
        }),
      });
      setLastSaved(new Date());
    } catch (e) {
      console.error(e);
    } finally {
      setIsSaving(false);
    }
  };

  // Flush pending grade changes
  const flushPendingChanges = useCallback(async () => {
    const gradeEntries = Array.from(pendingGrades.entries());
    const studentEntries = Array.from(pendingStudents.entries());

    if (gradeEntries.length > 0) {
      try {
        await fetch("/api/grades", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            updates: gradeEntries.map(([id, data]) => ({ id, ...data })),
          }),
        });
        setPendingGrades(new Map());
      } catch (e) {
        console.error(e);
      }
    }

    if (studentEntries.length > 0) {
      try {
        for (const [id, data] of studentEntries) {
          await fetch("/api/students", {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ id, ...data }),
          });
        }
        setPendingStudents(new Map());
      } catch (e) {
        console.error(e);
      }
    }
  }, [pendingGrades, pendingStudents]);

  // Auto-save every 30 seconds
  useEffect(() => {
    autoSaveTimer.current = setInterval(async () => {
      if (currentClassId) {
        await flushPendingChanges();
        setLastSaved(new Date());
      }
    }, AUTOSAVE_INTERVAL);

    return () => {
      if (autoSaveTimer.current) clearInterval(autoSaveTimer.current);
    };
  }, [currentClassId, flushPendingChanges]);

  // Update student (optimistic + debounced DB write)
  const handleUpdateStudent = useCallback(
    (studentId: string, data: Partial<Student>) => {
      setClassData((prev) => {
        if (!prev) return prev;
        return {
          ...prev,
          students: prev.students.map((s) =>
            s.id === studentId ? { ...s, ...data } : s
          ),
        };
      });

      setPendingStudents((prev) => {
        const next = new Map(prev);
        const existing = next.get(studentId) || {};
        next.set(studentId, { ...existing, ...data });
        return next;
      });

      // Debounced flush
      if (studentFlushTimer.current) clearTimeout(studentFlushTimer.current);
      studentFlushTimer.current = setTimeout(async () => {
        const student = classData?.students.find((s) => s.id === studentId);
        if (student) {
          try {
            const { id: _sid, ...studentRest } = student;
            await fetch("/api/students", {
              method: "PUT",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ id: studentId, ...studentRest, ...data }),
            });
            setPendingStudents((prev) => {
              const next = new Map(prev);
              next.delete(studentId);
              return next;
            });
          } catch (e) {
            console.error(e);
          }
        }
      }, 800);
    },
    [classData]
  );

  // Update grade (optimistic + debounced DB write)
  const handleUpdateGrade = useCallback(
    (gradeId: string, data: Partial<Grade>) => {
      setClassData((prev) => {
        if (!prev) return prev;
        return {
          ...prev,
          grades: prev.grades.map((g) =>
            g.id === gradeId ? { ...g, ...data } : g
          ),
        };
      });

      setPendingGrades((prev) => {
        const next = new Map(prev);
        const existing = next.get(gradeId) || {};
        next.set(gradeId, { ...existing, ...data });
        return next;
      });

      // Debounced flush for grades
      if (gradeFlushTimer.current) clearTimeout(gradeFlushTimer.current);
      gradeFlushTimer.current = setTimeout(async () => {
        const pending = Array.from(pendingGrades.entries());
        if (pending.length > 0) {
          try {
            await fetch("/api/grades", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                updates: pending.map(([id, d]) => ({ id, ...d })),
              }),
            });
            setPendingGrades(new Map());
            setLastSaved(new Date());
          } catch (e) {
            console.error(e);
          }
        }
      }, 500);
    },
    [pendingGrades]
  );

  // Update evaluation
  const handleUpdateEvaluation = useCallback(
    async (evalId: string, data: Partial<Evaluation>) => {
      // Optimistic update
      setClassData((prev) => {
        if (!prev) return prev;
        return {
          ...prev,
          evaluations: prev.evaluations.map((e) =>
            e.id === evalId ? { ...e, ...data } : e
          ),
        };
      });
      // Persist
      try {
        const eval_ = classData?.evaluations.find((e) => e.id === evalId);
        if (eval_) {
          const { id: _eid, ...evalRest } = eval_;
          await fetch("/api/evaluations", {
              method: "PUT",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ id: evalId, ...evalRest, ...data }),
            });
        }
      } catch (e) {
        console.error(e);
      }
    },
    [classData]
  );

  // Update all evaluations (global)
  const handleUpdateAllEvaluations = useCallback(
    async (type: EvaluationType, maxScore: 10 | 20, coefficient: 0.5 | 1 | 2) => {
      if (!classData) return;
      // Optimistic update
      setClassData((prev) => {
        if (!prev) return prev;
        return {
          ...prev,
          evaluations: prev.evaluations.map((e) => ({
            ...e,
            type,
            maxScore,
            coefficient,
          })),
        };
      });
      // Persist all
      try {
        for (const ev of classData.evaluations) {
          const { id: evId, ...evRest } = ev;
          await fetch("/api/evaluations", {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              id: evId,
              ...evRest,
              type,
              maxScore,
              coefficient,
            }),
          });
        }
      } catch (e) {
        console.error(e);
      }
    },
    [classData]
  );

  // Delete student data
  const handleDeleteStudent = useCallback(
    async (studentId: string, deleteType: string) => {
      try {
        await fetch("/api/students", {
          method: "DELETE",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ studentId, deleteType }),
        });
        if (currentClassId) await loadClassData(currentClassId);
      } catch (e) {
        console.error(e);
      }
    },
    [currentClassId]
  );

  // Reset class
  const handleResetClass = useCallback(
    async (resetType: string) => {
      if (!currentClassId) return;
      try {
        await fetch("/api/reset", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ classId: currentClassId, resetType }),
        });
        await loadClassData(currentClassId);
      } catch (e) {
        console.error(e);
      }
    },
    [currentClassId]
  );

  const currentClass = classes.find((c) => c.id === currentClassId) || null;

  return (
    <div
      className="flex flex-col"
      style={{ height: "100dvh", overflow: "hidden" }}
    >
      {/* Header */}
      <AppHeader
        currentClass={currentClass}
        lastSaved={lastSaved}
        onManualSave={handleManualSave}
        isSaving={isSaving}
      />

      {/* Main Layout */}
      <div className="flex flex-1 overflow-hidden">
        {/* Sidebar */}
        <ClassSidebar
          classes={classes}
          currentClassId={currentClassId}
          onSelectClass={handleSelectClass}
          onCreateClass={handleCreateClass}
          onDeleteClass={handleDeleteClass}
          onViewReport={() => setShowReport(true)}
        />

        {/* Main Content */}
        <main className="flex-1 overflow-hidden flex flex-col">
          {!currentClassId ? (
            <div
              className="flex-1 flex flex-col items-center justify-center"
              style={{
                background: "linear-gradient(135deg, #f0fdf4, #fefce8)",
              }}
            >
              <div className="text-center max-w-sm px-4">
                <div className="text-7xl mb-4">📚</div>
                <h2
                  className="text-2xl font-bold mb-3"
                  style={{ color: "#14532d" }}
                >
                  GradeBook Pro
                </h2>
                <p className="text-gray-500 mb-6 text-sm">
                  Bienvenue ! Sélectionnez une classe dans le menu à gauche ou créez une nouvelle classe pour commencer.
                </p>
                <div
                  className="rounded-xl p-4 text-xs space-y-2"
                  style={{
                    background: "#fef3c7",
                    border: "1px solid #d97706",
                    color: "#92400e",
                  }}
                >
                  <div className="font-bold text-sm mb-2">✨ Fonctionnalités</div>
                  <div>📋 100 élèves × 20 évaluations par classe</div>
                  <div>🏆 Tri par mérite ou ordre alphabétique</div>
                  <div>📊 Moyennes colorées en vert/rouge</div>
                  <div>🏅 Classement avec ex-aequo automatique</div>
                  <div>📝 4 types d&apos;évaluation avec couleurs</div>
                  <div>💾 Sauvegarde automatique & manuelle</div>
                  <div>📘 Livret scolaire annuel</div>
                </div>
              </div>
            </div>
          ) : loading ? (
            <div className="flex-1 flex items-center justify-center">
              <div className="text-center">
                <div
                  className="text-4xl animate-bounce mb-3"
                  style={{ color: "#16a34a" }}
                >
                  ⏳
                </div>
                <p className="text-gray-500 text-sm">Chargement de la classe...</p>
              </div>
            </div>
          ) : classData ? (
            <GradeTable
              students={classData.students}
              evaluations={classData.evaluations}
              grades={classData.grades}
              onUpdateStudent={handleUpdateStudent}
              onUpdateGrade={handleUpdateGrade}
              onUpdateEvaluation={handleUpdateEvaluation}
              onUpdateAllEvaluations={handleUpdateAllEvaluations}
              onDeleteStudent={handleDeleteStudent}
              onResetClass={handleResetClass}
            />
          ) : null}
        </main>
      </div>

      {/* Bottom action bar */}
      {currentClassId && (
        <div
          className="flex items-center justify-between px-3 py-1.5 border-t no-print"
          style={{
            background: "linear-gradient(135deg, #14532d, #166534)",
            borderColor: "#d97706",
          }}
        >
          <div className="flex gap-2">
            <button
              onClick={() => setShowSaves(true)}
              className="text-xs px-3 py-1 rounded-full font-semibold transition-all"
              style={{
                background: "rgba(254,243,199,0.2)",
                color: "#fef3c7",
                border: "1px solid rgba(254,243,199,0.3)",
              }}
            >
              💾 Sauvegardes
            </button>
          </div>
          <div
            className="flex items-center gap-2 text-xs"
            style={{ color: "#fde68a" }}
          >
            {lastSaved && (
              <span className="opacity-70">
                ✅ Auto-sauvegardé à {lastSaved.toLocaleTimeString("fr-FR")}
              </span>
            )}
          </div>
        </div>
      )}

      {/* Modals */}
      {showReport && (
        <ReportCard classes={classes} onClose={() => setShowReport(false)} />
      )}
      {showSaves && currentClassId && (
        <SavesModal classId={currentClassId} onClose={() => setShowSaves(false)} />
      )}
    </div>
  );
}
